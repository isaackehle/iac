# iac-secrets.env.example
#
# Template for the central secrets file used by scripts/gen-env.sh.
# Copy this to iac-secrets.env at the repo root (gitignored, or wherever IAC_SECRETS_FILE
# points) and fill in real values. This file lives OUTSIDE the git repo —
# never commit the real copy. See AGENTS.md for the full rationale.
#
# Format: plain KEY=value lines, one per line. Blank lines and comments
# (#) are ignored. scripts/gen-env.sh reads whatever keys a stack's
# .env.example asks for out of this single file.

# --- global ---
# Your tailnet's MagicDNS domain suffix (Tailscale admin console -> DNS).
# Used to auto-derive each stack's TS_CERT_DOMAIN as <stack>.<this>, so you
# don't need to repeat it per stack below.
TS_TAILNET_DOMAIN=your-tailnet-name.ts.net
TZ=America/New_York
NAS_LAN_IP=192.168.x.x
TS_AUTHKEY=tskey-change-me
ADMIN_EMAIL=user@email.net

# --- affine ---
DB_PASSWORD=

# --- frigate ---
FRIGATE_MQTT_HOST=
FRIGATE_MQTT_USER=
FRIGATE_MQTT_PASSWORD=
FRIGATE_RTSP_USER=
FRIGATE_RTSP_PASSWORD=

# --- homeassistant ---

# --- langfuse ---
# One-time manual step before first deploy: create the `langfuse` database
# and user on the existing `postgresql` stack's instance (see
# postgresql/DEBUG.md for connection details) — this stack does not run
# its own Postgres. See langfuse/.env.example for the exact SQL.
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_ROOT_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=

# --- mosquitto ---
MQTT_USER=zigbee
MQTT_PASSWORD=

# --- n8n ---
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# --- nextcloud ---
NC_DB_PASSWORD=
NC_ADMIN_USER=
NC_ADMIN_PASSWORD=

# --- openwebui ---
OPENWEBUI_API_KEY=

# --- pihole ---
PIHOLE_PASSWORD=
PIHOLE_UPSTREAMS=

# --- plex ---
PLEX_CLAIM=

# --- portainer ---
=

# --- postgresql ---
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
TS_AUTHKEY_POSTGRESQL=

# --- syncthing ---
SYNC_PUID=
SYNC_PGID=
