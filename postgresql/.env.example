# Copy to .env and fill in values before running docker compose up
# (or run scripts/gen-env.sh postgresql to generate it from the central
# secrets file — see iac-secrets.env.example)

# PostgreSQL superuser password
POSTGRES_PASSWORD=changeme

# pgAdmin login
PGADMIN_DEFAULT_EMAIL=you@example.com
PGADMIN_DEFAULT_PASSWORD=changeme

# Tailscale auth key for the sidecar (Pattern B)
TS_AUTHKEY_POSTGRESQL=tskey-auth-xxxx

# Tailscale cert domain (auto-derived from TS_TAILNET_DOMAIN + stack name)
TS_CERT_DOMAIN=postgresql.${TS_TAILNET_DOMAIN}
