# Observability environment variables for Docker Compose
TZ=America/New_York

# Tailscale auth key for the obs sidecar
# Generate at https://login.tailscale.com/admin/settings/keys (reusable, pre-authorized)
TS_AUTHKEY=

# The tailnet node is "obs", not the stack name, so set these explicitly.
TS_CERT_DOMAIN=obs.${TS_TAILNET_DOMAIN}
OBS_HOST=obs.${TS_TAILNET_DOMAIN}

# uid:gid the non-root services run as: isaac on the NAS (see the compose header).
OBS_PUID=1026
OBS_PGID=100

# Grafana's admin password
GRAFANA_ADMIN_PASSWORD=

# Telegram alerting (rendered into alertmanager config by scripts/deploy.sh env)
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=
# Discord alerting: the alerts channel's webhook URL (Channel settings ->
# Integrations -> Webhooks). Rendered to its own file, like the bot token.
DISCORD_ALERTS_WEBHOOK_URL=
# SNMPv3 credentials for the NAS (rendered into snmp-auth.yml)
SNMP_V3_USERNAME=
SNMP_V3_PASSWORD=
SNMP_V3_PRIV_PASSWORD=
