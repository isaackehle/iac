# Actual Budget environment variables for Docker Compose
TS_STACK_ROOT=/volume1/docker/stacks
TZ=America/New_York

# Tailscale auth key for the actualbudget sidecar
# Generate at https://login.tailscale.com/admin/settings/keys (reusable, pre-authorized)
TS_AUTHKEY=

TS_CERT_DOMAIN=actualbudget.${TS_TAILNET_DOMAIN}
