# Global environment variables for all Docker stacks
# Generated from iac-secrets.env — edit the secrets file and regenerate.

TZ=America/New_York                         # System timezone for all stacks
TS_AUTHKEY=                                 # Tailscale auth key (required for sidecars)
NAS_LAN_IP=                                 # NAS LAN IP (for internal DNS resolution)
ADMIN_EMAIL=                                # Admin email (certificates, alerts)
TS_TAILNET_DOMAIN=                          # Tailscale MagicDNS domain suffix
TS_STACK_ROOT=/volume1/docker/stacks        # Root directory for all stacks on NAS
