# Portainer deploys this stack from the repository (iac/nextcloud/docker-compose.yml).
# Fill in the values below in Portainer's "Environment variables" section when creating the stack,
# or create a .env file alongside docker-compose.yml if deploying manually.

# Database password for the PostgreSQL 'nextcloud' user
NC_DB_PASSWORD=

# Nextcloud admin account created on first run
NC_ADMIN_USER=
NC_ADMIN_PASSWORD=

# Tailscale sidecar — serves Nextcloud over HTTPS on your tailnet
# Generate a reusable auth key at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=${TS_AUTHKEY}
# Tailscale MagicDNS domain for the sidecar (e.g. nextcloud.${TS_TAILNET_DOMAIN})
TS_CERT_DOMAIN=nextcloud.${TS_TAILNET_DOMAIN}
