# mcp stack: MCP servers behind https://mcp.<tailnet>.ts.net (see INSTALLATION.md)
#
# synology server:
#
# See iac-secrets.env.example for the format and location of the secrets file.
# This file lists the variables required by the stack; their values come from
# the central secrets file via scripts/gen-env.sh.
#
# Variables:
#   SYNOLOGY_HOST     - the NAS's LAN IP (from NAS_LAN_IP). Not its tailnet name: the
#                       sidecar runs Tailscale in userspace mode, so containers in its
#                       namespace can't resolve or reach tailnet addresses.
#   SYNOLOGY_PORT     - DSM's HTTPS port (from DSM_HTTPS_PORT; DSM's default is 5001).
#                       If you changed it (see iac-secrets.env.example, "DSM ports"),
#                       set DSM_HTTPS_PORT in ~/.env; never commit the real value.
#   SYNOLOGY_SSL      - Whether to use SSL (true/false)
#   SYNOLOGY_USERNAME - DSM username for MCP authentication
#   SYNOLOGY_PASSWORD - DSM password (stored in iac-secrets.env)
#   SYNOLOGY_OTP_CODE - 2FA OTP code if 2FA is enabled (stored in iac-secrets.env)

SYNOLOGY_HOST=${NAS_LAN_IP}
SYNOLOGY_PORT=${DSM_HTTPS_PORT:-5001}
SYNOLOGY_SSL=true
SYNOLOGY_USERNAME=your-username
SYNOLOGY_PASSWORD=
SYNOLOGY_OTP_CODE=

# tailscale-admin server (read-only Tailscale admin API). Prefer an OAuth client
# (admin console → Settings → OAuth clients) with read scopes only:
# devices:core:read, users:read, policy_file:read. TAILSCALE_API_KEY is the
# fallback (full access). Leave all empty and the server answers "not configured".
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=-

# one-search server: web search via DuckDuckGo (free, no config needed).
# For better results, optionally set SEARXNG_URL (self-hosted SearXNG instance)
# or TAVILY_API_KEY (paid, but higher quality). Default is duckduckgo.
SEARCH_ENGINE=duckduckgo
SEARXNG_URL=
TAVILY_API_KEY=

# weather server: no configuration needed

# time server: no configuration needed  

# brave-search server: free tier available at https://brave.com/search/api/
# Overlaps with one-search; you can disable this service if not using it.
BRAVE_API_KEY=

# Tailscale sidecar (joins the tailnet as this stack's name; see serve.json.tmpl)
TS_AUTHKEY=
