# Environment variables for Mosquitto on Synology NAS
# In Portainer: set these under the stack's Environment variables section

TZ=America/New_York

# MQTT broker credentials (change these!)
# Generate strong passwords with: openssl rand -base64 32
MQTT_USER=zigbee
MQTT_PASSWORD=changeme123!secure

# Tailscale — reserved for a future sidecar; mosquitto currently has no
# Tailscale integration at all (reachable via the NAS host's tailscaled),
# so these are unused by the compose file today.
TS_AUTHKEY=
TS_CERT_DOMAIN=mosquitto.${TS_TAILNET_DOMAIN}
