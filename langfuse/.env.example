# Portainer deploys this stack from the repository (iac/langfuse/docker-compose.yml).
# Fill in the values below in Portainer's "Environment variables" section when creating the stack,
# or run scripts/gen-env.sh langfuse to generate ./langfuse/.env from iac-secrets.env.
#
# No working defaults for any of these — the stack fails to start rather
# than silently running with a placeholder password (deliberate).

# --- Postgres (reuses the `postgresql` stack, does not run its own) -----
# One-time manual step before first deploy — connect to the existing
# instance (see postgresql/DEBUG.md for the psql command, port 2665) and
# run:
#   CREATE DATABASE langfuse;
#   CREATE USER langfuse WITH PASSWORD '<same value as below>';
#   GRANT ALL PRIVILEGES ON DATABASE langfuse TO langfuse;
LANGFUSE_DB_PASSWORD=
# Host/port the langfuse containers use to reach that Postgres. They're on
# their own bridge network, so this must be the NAS's own address and the
# postgresql stack's *published* port — not `localhost` and not 5432.
LANGFUSE_DB_HOST=${NAS_LAN_IP}
LANGFUSE_DB_PORT=2665

# --- ClickHouse (trace/observation storage) -----------------------------
CLICKHOUSE_PASSWORD=

# --- Redis (queues/caching) ---------------------------------------------
REDIS_AUTH=

# --- MinIO (S3-compatible blob storage for event/media payloads) --------
MINIO_ROOT_PASSWORD=

# --- Langfuse app secrets ------------------------------------------------
# NEXTAUTH_SECRET / SALT: any long random string, e.g. `openssl rand -hex 32`
NEXTAUTH_SECRET=
SALT=
# ENCRYPTION_KEY: MUST be exactly 64 hex chars — `openssl rand -hex 32`
ENCRYPTION_KEY=

# --- Headless bootstrap (skips the first-run signup wizard; gives LiteLLM
# a fixed key pair to use immediately) ------------------------------------
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY: pick any string in the
# form Langfuse expects (`pk-lf-...` / `sk-lf-...`) — these become the
# actual API keys. Generate with:
#   python3 -c "import secrets; print('pk-lf-' + secrets.token_hex(16))"
#   python3 -c "import secrets; print('sk-lf-' + secrets.token_hex(16))"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=${ADMIN_EMAIL}
LANGFUSE_INIT_USER_PASSWORD=

# --- Tailscale sidecar — serves Langfuse over HTTPS on your tailnet ------
# Generate a reusable auth key at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=${TS_AUTHKEY}
# Tailscale MagicDNS domain for the sidecar (e.g. langfuse.${TS_TAILNET_DOMAIN})
TS_CERT_DOMAIN=langfuse.${TS_TAILNET_DOMAIN}
