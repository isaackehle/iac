# In Portainer: set these under the stack's Environment variables section,
# not as a real .env file, matching how the other stacks here are deployed.

# Tailscale auth key for the sidecar node
# Generate at https://login.tailscale.com/admin/settings/keys
# Use a reusable, pre-authorized key
TS_AUTHKEY=${TS_AUTHKEY}

# Tailscale MagicDNS domain (derived from TS_TAILNET_DOMAIN in the secrets file)
TS_CERT_DOMAIN=pihole.${TS_TAILNET_DOMAIN}

# Pi-hole web admin password
PIHOLE_PASSWORD=${PIHOLE_PASSWORD}

# Upstream DNS servers (semicolon-separated)
# Examples: "1.1.1.1;1.0.0.1" or "8.8.8.8;8.8.4.4"
PIHOLE_UPSTREAMS=${PIHOLE_UPSTREAMS}

# Timezone — must match your NAS setting
TZ={TZ}
