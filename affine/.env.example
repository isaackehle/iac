TS_STACK_ROOT=/volume1/docker/stacks
AFFINE_REVISION=stable
PORT=3010
UPLOAD_LOCATION=${TS_STACK_ROOT}/affine/data/storage
CONFIG_LOCATION=${TS_STACK_ROOT}/affine/data/config
