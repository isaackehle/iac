TS_HOSTNAME=affine
STACK_DIR=/volume1/docker/stacks/${TS_HOSTNAME}
AFFINE_REVISION=stable
PORT=3010
UPLOAD_LOCATION=/volume1/docker/stacks/affine/data/storage
CONFIG_LOCATION=/volume1/docker/stacks/affine/data/config
DB_DATA_LOCATION=/volume1/docker/stacks/affine/data/postgres
DB_USERNAME=affine
DB_PASSWORD=
DB_DATABASE=affine
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@affine_postgres:5432/${DB_DATABASE}

# Tailscale sidecar (joins the tailnet as this stack's name; see serve.json.tmpl)
TS_AUTHKEY=
