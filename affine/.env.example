# Tailscale — reserved for a future sidecar; affine is currently served
# host-level (see STACK_SERVE_PORTS in scripts/lib.sh), so these are
# unused by the compose file today.
TS_AUTHKEY=
TS_CERT_DOMAIN=affine.${TS_TAILNET_DOMAIN}