# OpenWebUI environment variables for Docker Compose
TZ=America/New_York

# Tailscale auth key for openwebui sidecar (get from https://login.tailscale.com/admin/key)
TS_AUTHKEY=

# Admin API key used by the config sidecar to register LiteLLM connections.
# Leave empty on first deploy -- it doesn't exist until you create the first
# (admin) account via the web UI once, then Settings -> Account -> API keys.
# The stack comes up fine without it; connections just aren't registered yet.
OPENWEBUI_API_KEY=

# JSON array of {"name": "<host>", "url": "<litellm /v1 base>"} -- one entry
# per fleet host's LiteLLM gateway (never Ollama; see homelab repo DEC-180/185).
# Generate the current value with: homelab/fleet/gen.py openwebui-connections
LITELLM_ENGINES=[]

# Tailscale MagicDNS domain for the sidecar
TS_CERT_DOMAIN=openwebui.${TS_TAILNET_DOMAIN}

# Optional: custom port mapping if you want host access in addition to tailnet
# OPENWEBUI_PORT=8080
